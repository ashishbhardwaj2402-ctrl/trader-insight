{
  "$id": "trader-insight/market-data/v1",
  "title": "Trader Insight Market Data v1",
  "description": "Vendor-neutral normalized market-data contracts. Cross-record ticker equality and bid/ask comparison are semantic invariants enforced by an offline fixture validator.",
  "$defs": {
    "ticker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
      "description": "Uppercase ticker symbol."
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "description": "UTC RFC 3339 timestamp with a Z suffix."
    },
    "UnderlyingMarketSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ticker", "price", "trend", "momentum", "expected_move", "expected_move_pct", "iv_30d", "iv_rank", "iv_percentile", "put_call_ratio", "max_pain", "updated_at"],
      "properties": {
        "schema_version": { "const": "market-data/v1" },
        "ticker": { "$ref": "#/$defs/ticker" },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "trend": { "enum": ["UPTREND", "DOWNTREND", "NEUTRAL"] },
        "momentum": { "enum": ["STRONG", "MODERATE", "WEAK"] },
        "expected_move": { "type": "number", "minimum": 0 },
        "expected_move_pct": { "type": "number", "minimum": 0 },
        "iv_30d": { "type": "number", "minimum": 0 },
        "iv_rank": { "type": "integer", "minimum": 0, "maximum": 100 },
        "iv_percentile": { "type": "number", "minimum": 0, "maximum": 100 },
        "put_call_ratio": { "type": "number", "minimum": 0 },
        "max_pain": { "type": "number", "exclusiveMinimum": 0 },
        "updated_at": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "OptionChainRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ticker", "strike", "option_type", "expiry", "days_to_expiry", "bid", "ask", "delta", "gamma", "theta", "vega", "rho", "open_interest", "volume", "updated_at"],
      "properties": {
        "schema_version": { "const": "market-data/v1" },
        "ticker": { "$ref": "#/$defs/ticker", "description": "Required selection field." },
        "strike": { "type": "number", "exclusiveMinimum": 0, "description": "Required selection field." },
        "option_type": { "enum": ["CALL", "PUT"], "description": "Required selection field." },
        "expiry": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Required selection field." },
        "days_to_expiry": { "type": "integer", "minimum": 0 },
        "bid": { "type": "number", "minimum": 0 },
        "ask": { "type": "number", "minimum": 0 },
        "delta": { "type": "number", "minimum": -1, "maximum": 1 },
        "gamma": { "type": "number", "minimum": 0 },
        "theta": { "type": "number" },
        "vega": { "type": "number", "minimum": 0 },
        "rho": { "type": "number" },
        "open_interest": { "type": "integer", "minimum": 0 },
        "volume": { "type": "integer", "minimum": 0 },
        "updated_at": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "MarketDataFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "underlying_snapshots", "option_chain_records"],
      "properties": {
        "schema_version": { "const": "market-data/v1" },
        "underlying_snapshots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/UnderlyingMarketSnapshot" } },
        "option_chain_records": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/OptionChainRecord" } }
      },
      "description": "Contains at least one snapshot and option record. Every option ticker must equal a snapshot ticker; equality is a semantic fixture-validator rule in addition to this portable schema."
    }
  },
  "$ref": "#/$defs/MarketDataFixture"
}
